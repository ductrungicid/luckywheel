{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/play", "destination": "/index.html" },
    { "source": "/settings", "destination": "/settings.html" }
  ],
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{resource/**,__pycache__/**,**/*.pyc}"
    }
  }
}
